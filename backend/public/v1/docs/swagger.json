        },
        "version": "1.0"
    },
    "servers": [
        {
            "url": "http://localhost/web-project/backend",
            "description": "Educos API server (XAMPP - Primary)"
        },
        {
            "url": "http://localhost:8000",
            "description": "Educos API server (Development)"
