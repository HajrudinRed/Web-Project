    "paths": {
        "/auth/register": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Register new user.",
                "description": "Add a new user to the database.",
                "requestBody": {
                    "description": "Add new user",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "password",
                                    "email",
                                    "name",
                                    "role"
                                ],
                                "properties": {
                                    "role": {
                                        "description": "User name",
                                        "type": "string",
                                        "example": "admin"
                                    },
                                    "name": {
                                        "description": "User name",
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "password": {
                                        "description": "User password",
                                        "type": "string",
                                        "example": "some_password"
                                    },
                                    "email": {
                                        "description": "User email",
                                        "type": "string",
                                        "example": "demo@gmail.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User has been added."
                    },
                    "500": {
                        "description": "Internal server error."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Login to system using email and password",
                "requestBody": {
                    "description": "User credentials",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "description": "User email address",
                                        "type": "string",
                                        "example": "demo@gmail.com"
                                    },
                                    "password": {
                                        "description": "User password",
                                        "type": "string",
                                        "example": "some_password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User data and JWT token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "User logged in successfully"
                                        },
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 65
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "John Doe"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "demo@gmail.com"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "example": "admin"
                                                },
                                                "created_at": {
                                                    "type": "string",
                                                    "example": "2025-06-03 22:23:00"
                                                },
                                                "token": {
                                                    "type": "string",
                                                    "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Login failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Invalid username or password."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/categories": {
            "get": {
                "tags": [
                    "categories"
                ],
                "summary": "Get all categories",
                "responses": {
                    "200": {
                        "description": "Get all categories"
                    }
                }
            },
            "post": {
                "tags": [
                    "categories"
                ],
                "summary": "Add or update a category",
                "requestBody": {
                    "description": "Category data payload",
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "number_of_courses",
                                    "image_url",
                                    "description"
                                ],
                                "properties": {
                                    "id": {
                                        "description": "Category ID",
                                        "type": "integer",
                                        "example": "1"
                                    },
                                    "name": {
                                        "description": "Category name",
                                        "type": "string",
                                        "example": "Programming"
                                    },
                                    "number_of_courses": {
                                        "description": "Number of courses in the category",
                                        "type": "integer",
                                        "example": "10"
                                    },
                                    "image_url": {
                                        "description": "Category image URL",
                                        "type": "string",
                                        "example": "http://example.com/image.jpg"
                                    },
                                    "description": {
                                        "description": "Category description",
                                        "type": "string",
                                        "example": "Courses related to programming."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Category data, or exception if category is not added properly"
                    }
                }
            }
        },
